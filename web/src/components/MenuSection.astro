---
import Figure from './Figure.astro';
import { lp } from '../lib/i18n';
import type { Lang } from '../lib/i18n';
import { ui } from '../lib/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].menu;
// le foto dei piatti, nello stesso ordine dei testi alternativi in `menu.gallery.alts`:
// carne, antipasto, pasta, tagliere, umido, dolci
const slots = ['piatti/1-bistecca', 'eventi', 'piatti/2-pasta', 'locali/trattoria-1978-2-tagliere', 'piatti/3-umido', 'piatti/4-dolci'];
const dishes = slots.map((slot, i) => ({ slot, alt: t.gallery.alts[i] }));
---
<section class="menu" id="menu">
  <div class="menu__top">
  <div class="menu__intro" data-reveal>
    <h2 class="menu__title">{t.title}</h2>
    <p class="menu__note">{t.note}</p>
    <div class="menu__ctas">
      <a class="btn btn--ink" href={lp(lang, '/menu/')}>{t.cta}</a>
      <a class="link-more" href={lp(lang, '/menu/#to-go')}>{t.ctaToGo} &rarr;</a>
    </div>
  </div>

  {/* La carta di una trattoria, ma dove andrebbe il prezzo c'è la promessa. */}
  <a class="carta" href={lp(lang, '/menu/')} data-carta>
    <span class="carta__head u-label">{t.card}</span>
    <ul class="carta__list">
      {t.items.map((item, i) => (
        <li class="carta__row" style={`--i:${i}`}>
          <span class="carta__item">{item}</span>
          <span class="carta__dots" aria-hidden="true"></span>
          <span class="carta__free">{t.free}</span>
        </li>
      ))}
    </ul>
    <span class="carta__more">{t.cardMore} <span aria-hidden="true">&rarr;</span></span>
  </a>
  </div>

  {/* I piatti veri, fotografati nei nostri locali: da computer una griglia,
      da telefono un carosello che si scorre col dito e avanza da solo. */}
  <div class="dishes" data-dishes data-reveal>
    <ul class="dishes__track" aria-label={t.gallery.label} data-dishes-track>
      {dishes.map((d) => (
        <li class="dishes__item">
          {/* riquadro quadrato: le foto orizzontali servono larghe 1,5 volte il lato */}
          <Figure slot={d.slot} alt={d.alt} label="" widths={[480, 800, 1200, 1600]} sizes="(max-width: 760px) 130vw, 50vw" />
        </li>
      ))}
    </ul>
    <div class="dishes__dots">
      {dishes.map((_, i) => (
        <button class="dishes__dot" type="button" aria-label={t.gallery.slide(i + 1, dishes.length)} aria-current={i === 0 ? 'true' : undefined} data-dish={i}></button>
      ))}
    </div>
  </div>
</section>

<script>
  // I puntini corrono verso «senza glutine» quando la carta entra in vista.
  // Senza JS, o con il movimento ridotto, la carta è già completa.
  const carta = document.querySelector<HTMLElement>('[data-carta]');
  if (carta && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    carta.classList.add('is-armed');
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        carta.classList.add('is-in');
        io.disconnect();
      }
    }, { threshold: 0.35 });
    io.observe(carta);
  }

  // Il carosello dei piatti, solo da telefono (da computer è una griglia e i
  // puntini sono nascosti). Scorrere col dito è nativo (scroll-snap); qui si
  // tengono allineati i puntini e si avanza da soli ogni 4 secondi, finché chi
  // guarda non tocca: da quel momento decide lui.
  const root = document.querySelector<HTMLElement>('[data-dishes]');
  const track = root?.querySelector<HTMLElement>('[data-dishes-track]');
  if (root && track) {
    const items = [...track.children] as HTMLElement[];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dish]')];
    const mobile = matchMedia('(max-width: 760px)');
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let manual = false;
    let visible = false;
    let timer: number | undefined;

    const mark = (i: number) => {
      current = i;
      dots.forEach((d, k) => (k === i ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
    };
    const go = (i: number) => {
      const item = items[i];
      track.scrollTo({ left: item.offsetLeft - track.offsetLeft - (track.clientWidth - item.clientWidth) / 2, behavior: still.matches ? 'auto' : 'smooth' });
    };

    // il puntino segue la foto più vicina al centro
    let frame = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const mid = track.scrollLeft + track.clientWidth / 2;
        let best = 0;
        items.forEach((it, k) => {
          const c = it.offsetLeft - track.offsetLeft + it.clientWidth / 2;
          if (Math.abs(c - mid) < Math.abs(items[best].offsetLeft - track.offsetLeft + items[best].clientWidth / 2 - mid)) best = k;
        });
        mark(best);
      });
    }, { passive: true });

    const stop = () => { window.clearInterval(timer); timer = undefined; };
    const start = () => {
      stop();
      if (manual || still.matches || !mobile.matches || !visible || document.hidden) return;
      timer = window.setInterval(() => go((current + 1) % items.length), 4000);
    };
    // basta un tocco, uno scorrimento o un puntino: l'avanzamento automatico si ferma
    const takeOver = () => { manual = true; stop(); };
    track.addEventListener('pointerdown', takeOver, { passive: true });
    track.addEventListener('touchstart', takeOver, { passive: true });
    track.addEventListener('wheel', takeOver, { passive: true });
    dots.forEach((d, i) => d.addEventListener('click', () => { takeOver(); go(i); }));

    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => { visible = entries.some((e) => e.isIntersecting); start(); }, { threshold: 0.5 }).observe(track);
    }
    document.addEventListener('visibilitychange', start);
    mobile.addEventListener('change', start);
  }
</script>
