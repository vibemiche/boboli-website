---
import { href } from '../lib/site';
---
<div class="duo">
  <section class="duo__panel duo__panel--ink" id="cantina">
    <p class="u-label duo__kicker">Cantina</p>
    <h2 class="duo__title">Non solo cosa mangi. Anche cosa bevi.</h2>
    <p class="duo__body"><span class="d-only">Selezione vini, abbinamenti, degustazioni. </span>Via Romana, 60R.</p>
    <a class="btn btn--cream" href={href('/#firenze')}>Scopri la cantina &rarr;</a>
  </section>
  <section class="duo__panel duo__panel--terracotta" id="shop">
    <p class="u-label duo__kicker">Shop</p>
    <h2 class="duo__title">Boboli, anche a casa.</h2>
    <p class="duo__body">Pasta<span class="d-only"> fresca e secca</span>, sughi, <span class="d-only">prodotti artigianali, </span>kit e box.</p>
    <a class="btn btn--white" href={href('/#shop')}>Scopri i prodotti &rarr;</a>
  </section>
</div>
