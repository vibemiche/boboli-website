---
import ShortLink from '../../../components/ShortLink.astro';
import { TRANSLATED } from '../../../lib/i18n';
import type { Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  return TRANSLATED.map((lang) => ({ params: { lang } }));
}
---
<ShortLink lang={Astro.params.lang as Lang} to="/#locali" />
