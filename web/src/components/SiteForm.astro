---
import { lp } from '../lib/i18n';
import type { Lang } from '../lib/i18n';
import { ui } from '../lib/ui';
import { formAction } from '../lib/forms';

// Un modulo che arriva per mail, tramite FormSubmit: funziona anche senza
// JavaScript. Con JavaScript l'oggetto della mail si compone dai campi
// (`subject`, con i nomi dei campi tra graffe), il bottone mostra l'invio e, al
// ritorno sulla pagina, al posto del modulo compare il messaggio di conferma.
interface Props {
  id: string;
  lang: Lang;
  /** La casella che riceve il modulo. */
  to: string;
  /** La pagina in cui sta il modulo, senza lingua: `/eventi/`. */
  path: string;
  /** Es. «NUOVA CANDIDATURA - {Nome} {Cognome} - {Telefono} - {Email}». */
  subject: string;
  submit: string;
  success: string;
  files?: boolean;
  class?: string;
}
const { id, lang, to, path, subject, submit, success, files = false, class: className } = Astro.props;
const f = ui[lang].form;
const site = Astro.site!;
// dopo l'invio FormSubmit riporta qui, con il segno che il modulo è partito
const next = new URL(lp(lang, path), site).href + `?inviato=${id}#${id}`;
// senza JavaScript l'oggetto resta quello fisso, senza i campi
const fallback = subject.split(' - {')[0].trim();
---
<div class:list={['fs', className]} id={id}>
  <form
    class="fs__form"
    action={formAction(to)}
    method="POST"
    enctype={files ? 'multipart/form-data' : undefined}
    data-fs
    data-subject={subject}
    data-sending={f.sending}
  >
    <input type="hidden" name="_subject" value={fallback} />
    <input type="hidden" name="_next" value={next} />
    <input type="hidden" name="_template" value="table" />
    <input type="hidden" name="_captcha" value="false" />
    {/* «Rispondi» nella mail va a chi ha scritto: lo riempie lo script con il campo Email */}
    <input type="hidden" name="_replyto" value="" />
    <input type="hidden" name="Lingua del sito" value={lang.toUpperCase()} />
    {/* trappola per i bot: un campo che le persone non vedono e lasciano vuoto */}
    <div class="fs__trap" aria-hidden="true"><label>Lascia vuoto <input type="text" name="_honey" tabindex="-1" autocomplete="off" /></label></div>

    <div class="fs__grid">
      <slot />
    </div>

    <label class="fs__check">
      <input type="checkbox" name="Privacy" value="Informativa letta" required />
      <span>{f.privacy[0]}<a href={lp('it', '/privacy/')} target="_blank" rel="noopener">{f.privacy[1]}</a>{f.privacy[2]}<span aria-hidden="true"> *</span></span>
    </label>
    <p class="fs__note">{f.requiredNote}</p>
    <button class="btn btn--terracotta fs__submit" type="submit">{submit} <span aria-hidden="true">&rarr;</span></button>
  </form>
  <div class="fs__success" role="status" tabindex="-1" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5 10 17 19 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <p>{success}</p>
  </div>
</div>

<script>
  const sent = new URLSearchParams(location.search).get('inviato');
  document.querySelectorAll<HTMLFormElement>('form[data-fs]').forEach((form) => {
    const box = form.parentElement!;
    const done = box.querySelector<HTMLElement>('.fs__success')!;

    // ritorno da FormSubmit: il modulo è partito, mostro la conferma
    if (sent && sent === box.id) {
      form.hidden = true;
      done.hidden = false;
      ((window as any).dataLayer ||= []).push({ event: 'form_sent', form: box.id });
      requestAnimationFrame(() => done.focus({ preventScroll: true }));
      history.replaceState(null, '', location.pathname + location.hash);
    }

    // date: niente giorni passati
    const today = new Date(Date.now() - new Date().getTimezoneOffset() * 60000).toISOString().slice(0, 10);
    form.querySelectorAll<HTMLInputElement>('input[type="date"]').forEach((d) => { if (!d.min) d.min = today; });

    // file troppo grande: lo dico subito, non dopo l'invio
    form.querySelectorAll<HTMLInputElement>('input[type="file"][data-max-mb]').forEach((input) => {
      input.addEventListener('change', () => {
        const max = Number(input.dataset.maxMb) * 1024 * 1024;
        const file = input.files?.[0];
        input.setCustomValidity(file && file.size > max ? input.dataset.tooBig ?? '' : '');
        input.reportValidity();
      });
    });

    form.addEventListener('submit', (e) => {
      if (!form.checkValidity()) { e.preventDefault(); form.reportValidity(); return; }
      const data = new FormData(form);
      // nell'oggetto le date si leggono all'italiana: 12/12/2026
      const val = (k: string) => {
        const v = String(data.get(k) ?? '').trim();
        return /^\d{4}-\d{2}-\d{2}$/.test(v) ? v.split('-').reverse().join('/') : v;
      };
      const subject = (form.dataset.subject ?? '').replace(/\{([^}]+)\}/g, (_, k) => val(k));
      form.querySelector<HTMLInputElement>('input[name="_subject"]')!.value = subject.replace(/\s+/g, ' ').trim();
      form.querySelector<HTMLInputElement>('input[name="_replyto"]')!.value = val('Email');
      const btn = form.querySelector<HTMLButtonElement>('.fs__submit')!;
      btn.dataset.label = btn.innerHTML;
      btn.disabled = true;
      btn.textContent = form.dataset.sending ?? '…';
    });
  });

  // tornando indietro con il browser il bottone non deve restare bloccato
  window.addEventListener('pageshow', (e) => {
    if (!e.persisted) return;
    document.querySelectorAll<HTMLButtonElement>('form[data-fs] .fs__submit').forEach((b) => {
      b.disabled = false;
      if (b.dataset.label) b.innerHTML = b.dataset.label;
    });
  });
</script>
