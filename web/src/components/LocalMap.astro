---
import type { Lang } from '../lib/i18n';
import type { Locale } from '../lib/locali';
import { ui } from '../lib/ui';
import { directionsUrl } from '../lib/contact';

interface Props { lang: Lang; locali: Locale[] }
const { lang, locali } = Astro.props;
const t = ui[lang].locations;

const pins = locali
  .filter((l) => l.geo)
  .map((l) => ({ id: l.id, civic: l.civic, name: l.nameShort, street: l.street, lat: l.geo!.lat, lng: l.geo!.lng, maps: directionsUrl(l) }));

// Riferimenti per chi non conosce Firenze: danno la scala e dicono subito
// che Via Romana è dietro Palazzo Pitti, a due passi dal Ponte Vecchio.
const landmarks = [
  { name: t.landmarks.duomo, lat: 43.77314, lng: 11.2559 },
  { name: t.landmarks.ponte, lat: 43.76797, lng: 11.25315 },
  { name: t.landmarks.pitti, lat: 43.76502, lng: 11.25002 },
  { name: t.landmarks.boboli, lat: 43.7625, lng: 11.2488 },
  { name: t.landmarks.croce, lat: 43.76858, lng: 11.26222 },
];

const data = { pins, landmarks, directions: t.directions };
---
<div class="map" role="region" aria-label={t.mapLabel} data-map={JSON.stringify(data)}>
  {/* Prima dello script, e senza JS, la mappa è una lista di indicazioni: mai un buco. */}
  <ul class="map__fallback">
    {pins.map((p) => (
      <li><a href={p.maps} target="_blank" rel="noopener"><b>{p.civic}</b> {p.street}</a></li>
    ))}
  </ul>
</div>

<script>
  type Pin = { id: string; civic: string; name: string; street: string; lat: number; lng: number; maps: string };
  type Mark = { name: string; lat: number; lng: number };

  const el = document.querySelector<HTMLElement>('.map');
  const data: { pins: Pin[]; landmarks: Mark[]; directions: string } = JSON.parse(el?.dataset.map ?? '{"pins":[]}');

  // Leaflet pesa quanto l'hero intero: si carica solo quando la sezione si avvicina.
  if (el && data.pins.length) {
    const io = new IntersectionObserver(
      async (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        // Il CSS con `?url` resta un asset: importato in modo statico Astro lo
        // metterebbe nell'head. Le regole del sito vincono per specificità.
        const [{ default: L }, { default: cssUrl }] = await Promise.all([import('leaflet'), import('leaflet/dist/leaflet.css?url')]);
        await new Promise<void>((resolve) => {
          const link = Object.assign(document.createElement('link'), { rel: 'stylesheet', href: cssUrl, onload: () => resolve(), onerror: () => resolve() });
          document.head.append(link);
        });
        el.querySelector('.map__fallback')?.remove();

        // Con un dito la pagina scorre, con due la mappa zooma: su telefono la
        // mappa non deve intrappolare lo scroll.
        const touch = L.Browser.mobile;
        const map = L.map(el, { scrollWheelZoom: false, dragging: !touch, zoomSnap: 0.25 });
        L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
          maxZoom: 19,
          subdomains: 'abcd',
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
        }).addTo(map);

        data.landmarks.forEach((m) => {
          L.marker([m.lat, m.lng], {
            icon: L.divIcon({ className: 'map__mark', html: `<span>${m.name}</span>`, iconSize: [0, 0] }),
            interactive: false,
            keyboard: false,
            zIndexOffset: -2000,
          }).addTo(map);
        });

        const rows = document.querySelectorAll<HTMLElement>('[data-locale-row]');
        const markers = new Map<string, L.Marker>();
        const setActive = (id: string | null) => {
          markers.forEach((m, k) => m.getElement()?.classList.toggle('is-active', k === id));
          rows.forEach((r) => r.classList.toggle('is-active', r.dataset.localeRow === id));
        };

        data.pins.forEach((p) => {
          const m = L.marker([p.lat, p.lng], {
            icon: L.divIcon({ className: 'map__pin', html: `<span>${p.civic}</span>`, iconSize: [0, 0] }),
            title: p.name,
          })
            .bindPopup(`<b>${p.name}</b><br>${p.street}<br><a href="${p.maps}" target="_blank" rel="noopener">${data.directions} &rarr;</a>`)
            .addTo(map);
          m.on('mouseover', () => setActive(p.id));
          m.on('mouseout', () => setActive(null));
          markers.set(p.id, m);
        });
        rows.forEach((r) => {
          r.addEventListener('mouseenter', () => setActive(r.dataset.localeRow ?? null));
          r.addEventListener('mouseleave', () => setActive(null));
        });

        // Tre civici di Via Romana stanno in cinquanta metri. Le etichette vicine
        // salgono una sopra l'altra; ognuna tiene la sua asta e il suo punto, e
        // quelle più alte stanno dietro, così un'asta non taglia un'etichetta.
        const layout = () => {
          const placed: { x: number; y: number }[] = [];
          data.pins.forEach((p) => {
            const m = markers.get(p.id)!;
            const pt = map.latLngToLayerPoint(m.getLatLng());
            const near = placed.filter((q) => Math.abs(q.x - pt.x) < 48 && Math.abs(q.y - pt.y) < 40).length;
            m.setZIndexOffset(-near * 100);
            m.getElement()?.querySelector<HTMLElement>('span')?.style.setProperty('--lift', `${near * 32}px`);
            placed.push({ x: pt.x, y: pt.y });
          });
        };
        map.on('zoomend', layout);
        const pts = [...data.pins, ...data.landmarks].map((p) => [p.lat, p.lng] as [number, number]);
        map.fitBounds(pts, { padding: [28, 28] });
        layout();
      },
      { rootMargin: '240px' },
    );
    io.observe(el);
  }
</script>
