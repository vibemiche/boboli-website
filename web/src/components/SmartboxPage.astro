---
import Base from '../layouts/Base.astro';
import Figure from './Figure.astro';
import { lp } from '../lib/i18n';
import type { Lang } from '../lib/i18n';
import { getLocali } from '../lib/locali';
import { ui } from '../lib/ui';
import { telHref } from '../lib/contact';
import { SMARTBOX_REGISTER } from '../lib/forms';
import { breadcrumbSchema } from '../lib/schema';

// La Smartbox: prima si registra il voucher sul sito Smartbox, poi si prenota
// in uno dei locali che la accettano.
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const s = t.smartbox;
const site = Astro.site!;
const locali = (await getLocali(lang)).filter((l) => l.smartbox);
const jsonLd = [breadcrumbSchema([{ name: 'Trattoria Boboli', url: lp(lang, '/') }, { name: 'Smartbox', url: lp(lang, '/smartbox/') }], site)];
---
<Base lang={lang} path="/smartbox/" title={s.title} description={s.desc} image={null} jsonLd={jsonLd}>
  <article class="gift">
    <nav class="u-label place__crumb" aria-label={t.place.crumb}>
      <a href={lp(lang, '/')}>Boboli</a> › <span aria-current="page">Smartbox</span>
    </nav>
    <header class="gift__head">
      <div>
        {/* il sopratitolo sta dentro l'h1: Google legge anche le parole che si cercano */}
        <h1 class="h1-stack">
          <span class="u-label gift__kicker">{s.kicker}</span>
          <span class="gift__title">{s.h1}</span>
        </h1>
        <p class="gift__lead">{s.lead}</p>
        <a class="btn btn--terracotta gift__cta" href={SMARTBOX_REGISTER} target="_blank" rel="noopener">
          {s.cta} <span aria-hidden="true">&rarr;</span><span class="sr-only"> ({s.newTab})</span>
        </a>
      </div>
      <ol class="events__steps gift__steps" aria-label={s.stepsTitle}>
        {s.steps.map((step, i) => <li><span class="events__num" aria-hidden="true">{i + 1}</span><p>{step}</p></li>)}
      </ol>
    </header>

    <ul class="gift__list">
      {locali.map((l) => (
        <li class="ticket">
          <div class="ticket__stub" aria-hidden="true">
            <span class="ticket__civic">{l.civic}</span>
            <span class="u-label ticket__brand">Smartbox</span>
          </div>
          <div class="ticket__body">
            {l.seal && <Figure class="ticket__seal" slot={`illustrazioni/${l.seal}`} alt="" label="" widths={[160, 320]} sizes="96px" />}
            <h2 class="ticket__name"><a href={lp(lang, `/locali/${l.id}/`)}>{l.nameLegal}</a></h2>
            <p class="ticket__addr">{l.street} · {l.zone}</p>
            <div class="ticket__actions">
              <a class="btn btn--terracotta ticket__cta" href={SMARTBOX_REGISTER} target="_blank" rel="noopener">
                {s.cta} <span aria-hidden="true">&rarr;</span><span class="sr-only"> — {l.nameLegal} ({s.newTab})</span>
              </a>
              {l.phone && <a class="ticket__call" href={telHref(l.phone)}>{s.call} · {l.phone}</a>}
            </div>
          </div>
        </li>
      ))}
    </ul>

    <p class="gift__note">{s.note}</p>
  </article>
</Base>
