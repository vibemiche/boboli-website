---
import Figure from './Figure.astro';
import type { Lang } from '../lib/i18n';
import { ui } from '../lib/ui';

interface Props { lang: Lang }
const t = ui[Astro.props.lang].menu;
---
<section class="menu" id="menu">
  <h2 class="menu__title">{t.title}</h2>
  <ul class="menu__list">
    {t.items.map((item) => <li class="menu__item">{item}</li>)}
  </ul>
  <p class="menu__note">{t.note}</p>
  <div class="menu__gallery">
    {Object.entries(t.gallery).map(([slug, [label, line, alt]]) => (
      <figure>
        <Figure slot={`illustrazioni/${slug}`} alt={alt} label={label} widths={[300, 600]} sizes="(max-width: 760px) 50vw, 25vw" />
        <figcaption><span class="u-label">{label}</span>{line}</figcaption>
      </figure>
    ))}
  </div>
  <div class="menu__shop" id="prodotti">
    <p><strong>{t.shopStrong}</strong> {t.shopText}</p>
  </div>
</section>
