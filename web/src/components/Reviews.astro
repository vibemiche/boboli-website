---
const quotes = [1, 2, 3];
---
<section class="reviews">
  <div class="reviews__head">
    <p class="u-label">Recensioni per temi · 35.000+</p>
    <p class="u-label reviews__themes d-only">Gluten free · Cucina · Atmosfera · Servizio · Vino</p>
  </div>
  <div class="reviews__grid">
    {quotes.map((n) => (
      <figure class:list={['review', { 'd-only': n > 1 }]}>
        <blockquote>“Citazione ospite{n === 1 && <span class="m-only"> — tema gluten free</span>}.”</blockquote>
        <figcaption class:list={['u-label', { 'd-only': n === 1 }]}>Nome · Fonte</figcaption>
      </figure>
    ))}
  </div>
</section>
