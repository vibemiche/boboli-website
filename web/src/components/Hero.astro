---
import Figure from './Figure.astro';

// Sei scelte, tutte visibili insieme: la quantità è il messaggio.
const choices = ['la pasta.', 'il pane.', 'il panino.', 'pranzo o cena.', 'dove sederti.', 'con chi venire.'];
---
<section class="hero" id="top">
  <Figure
    slot="hero"
    class="hero__media"
    alt="La sala della Trattoria Boboli a Firenze, tutta la cucina senza glutine"
    label="IMG FULL-SCREEN — la tavola dall'alto, piena di piatti diversi, tutto senza glutine"
    widths={[768, 1280, 1920, 2560]}
    priority
  />
  <div class="hero__bottom">
    <h1 class="hero__word">Scegli</h1>
    <div class="hero__col">
      <ul class="hero__list" aria-label="Cosa scegli da Boboli">
        {choices.map((c, i) => <li style={`--i:${i}`}>{c}</li>)}
      </ul>
      <p class="hero__answer">Tutto senza glutine.</p>
      <p class="hero__since u-label">Firenze, dal 1978.</p>
    </div>
  </div>
</section>
