---
import Figure from './Figure.astro';
import BookButton from './BookButton.astro';
import { lp } from '../lib/i18n';
import type { Lang } from '../lib/i18n';
import type { Locale } from '../lib/locali';
import { ui } from '../lib/ui';

interface Props { lang: Lang; locale: Locale; dark?: boolean; bleed?: boolean }
const { lang, locale: l, dark = false, bleed = false } = Astro.props;
---
<section class:list={['format', { 'format--dark': dark, 'format--bleed': bleed }]}>
  <div class="format__media">
    <Figure slot={`locali/${l.id}`} alt={l.imageAlt} label={`IMG — ${l.imageAlt}`} widths={[768, 1280, 1920, 2560]} />
    <span class="format__num" aria-hidden="true">{l.civic}</span>
  </div>
  <div class="format__body">
    <div class="format__text">
      <p class="u-label format__kicker">{l.kicker}</p>
      <h2 class="format__title">{l.title}</h2>
      {l.insight && <p class="format__insight">{l.insight}</p>}
      <p class="format__blurb">{l.blurb}</p>
      <p class="u-label format__address">{l.street} · {l.zone}</p>
    </div>
    <div class="format__actions">
      <a class="link-more" href={lp(lang, `/locali/${l.id}/`)}>{ui[lang].format.more} &rarr;</a>
      <BookButton lang={lang} locale={l} class={dark ? 'btn--cream' : 'btn--ink'} />
    </div>
  </div>
</section>
