---
import Base from '../layouts/Base.astro';
import Figure from './Figure.astro';
import { lp } from '../lib/i18n';
import type { Lang } from '../lib/i18n';
import { ui } from '../lib/ui';
import { ABOUT } from '../lib/about';
import { breadcrumbSchema, socialImage } from '../lib/schema';

// «Chi siamo»: la storia della famiglia, con il testo della prima pagina del menu.
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const a = ABOUT[lang];
const site = Astro.site!;
const path = '/chi-siamo/';
const image = await socialImage('chi-siamo/famiglia', site);
const url = new URL(lp(lang, path), site).href;
const jsonLd = [
  breadcrumbSchema([{ name: 'Trattoria Boboli', url: lp(lang, '/') }, { name: a.label, url: lp(lang, path) }], site),
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    '@id': url,
    url,
    name: a.title,
    description: a.desc,
    inLanguage: lang,
    about: { '@id': new URL(lp('it', '/'), site).href + '#organization' },
  },
];
---
<Base lang={lang} path={path} title={a.title} description={a.desc} image={image} jsonLd={jsonLd}>
  <article class="join join--about">
    <nav class="u-label place__crumb" aria-label={t.place.crumb}>
      <a href={lp(lang, '/')}>Boboli</a> › <span aria-current="page">{a.label}</span>
    </nav>
    {/* stessa testata di Lavora con noi ed Eventi: sopratitolo e titolo nell'h1,
        il primo paragrafo del menu come attacco, la foto di famiglia nel tondo */}
    <header class="join__head">
      <div>
        <h1 class="h1-stack">
          <span class="u-label join__kicker">{a.kicker}</span>
          <span class="join__title">{a.h1}</span>
        </h1>
        <p class="join__lead">{a.body[0]}</p>
      </div>
      <Figure class="join__seal about__seal" slot="chi-siamo/famiglia" alt={a.alt.family} label="" widths={[262]} sizes="300px" />
    </header>

    <div class="about__story">
      <div class="about__text">
        {a.body.slice(1).map((p) => <p>{p}</p>)}
      </div>
      <figure class="about__archive">
        <figcaption class="u-label">{a.archive}</figcaption>
        <Figure slot="chi-siamo/archivio-1-fattoria-rufina" alt={a.alt.rufina} label="" widths={[230]} sizes="260px" />
        <Figure slot="chi-siamo/archivio-2-cortile" alt={a.alt.yard} label="" widths={[231]} sizes="260px" />
      </figure>
    </div>
  </article>
</Base>
