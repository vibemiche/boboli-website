---
import Figure from './Figure.astro';
import LocalMap from './LocalMap.astro';
import BookButton from './BookButton.astro';
import { lp } from '../lib/i18n';
import type { Lang } from '../lib/i18n';
import type { Locale } from '../lib/locali';
import { ui } from '../lib/ui';
import { telHref, formatHours } from '../lib/contact';

interface Props { lang: Lang; locali: Locale[] }
const { lang, locali } = Astro.props;
const t = ui[lang];
---
<section class="locations" id="firenze">
  <h2 class="locations__title">{t.locations.title}</h2>
  <div class="locations__grid">
    <LocalMap lang={lang} locali={locali} />
    <ul class="locations__list">
      {locali.map((l) => (
        <li data-locale-row={l.id}>
          <span class="locations__civic" aria-hidden="true">{l.civic}</span>
          <div>
            <a class="locations__name" href={lp(lang, `/locali/${l.id}/`)}>{l.nameShort}</a>
            <p class="locations__addr">{l.street}, {l.postalCode} {l.city} · {l.zone}</p>
            <p class="locations__meta">
              {l.phone && <a href={telHref(l.phone)}>{l.phone}</a>}
              {formatHours(l.hours, t.hours).map((h) => <span>{h}</span>)}
            </p>
          </div>
          <BookButton lang={lang} locale={l} class="btn--terracotta" />
        </li>
      ))}
    </ul>
  </div>
  <figure class="locations__firenze">
    <Figure
      slot="firenze"
      class="locations__firenze-img"
      alt={t.locations.firenzeAlt}
      label="IMG — Firenze"
      widths={[768, 1280, 1920]}
      sizes="100vw"
    />
    <figcaption class="locations__firenze-caption">{t.locations.firenzeCaption}</figcaption>
  </figure>
</section>
