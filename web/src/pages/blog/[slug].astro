---
import BlogPost from '../../components/BlogPost.astro';
import { getPosts } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts('it');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, others: posts.filter((p) => p.id !== post.id) } }));
}
const { post, others } = Astro.props;
---
<BlogPost lang="it" post={post} others={others} />
