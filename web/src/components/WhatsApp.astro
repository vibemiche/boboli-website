---
import type { Lang } from '../lib/i18n';
import { ui } from '../lib/ui';
import { WHATSAPP } from '../lib/forms';

// Il pulsante fluttuante in basso a destra: apre la chat WhatsApp con Boboli.
// Da telefono sta sopra la barra con «Il menu» e «Prenota un tavolo».
interface Props { lang: Lang }
const label = ui[Astro.props.lang].nav.whatsapp;
---
<a class="whatsapp" href={`https://wa.me/${WHATSAPP}`} target="_blank" rel="noopener" aria-label={label}>
  <svg viewBox="0 0 32 32" aria-hidden="true">
    <path fill="currentColor" d="M16.02 3C8.84 3 3 8.83 3 16c0 2.3.6 4.53 1.75 6.5L3 29l6.68-1.74A12.98 12.98 0 0 0 16.02 29C23.2 29 29 23.17 29 16S23.2 3 16.02 3Zm0 23.62c-2.02 0-4-.54-5.73-1.57l-.41-.24-3.96 1.04 1.06-3.86-.27-.4A10.6 10.6 0 0 1 5.4 16c0-5.86 4.77-10.62 10.63-10.62S26.6 10.14 26.6 16s-4.73 10.62-10.58 10.62Zm5.82-7.95c-.32-.16-1.89-.93-2.18-1.04-.3-.1-.5-.16-.72.16-.21.32-.82 1.04-1 1.25-.19.21-.37.24-.69.08-.32-.16-1.35-.5-2.57-1.59-.95-.85-1.59-1.9-1.78-2.22-.18-.32-.02-.49.14-.65.15-.14.32-.37.48-.56.16-.18.21-.32.32-.53.1-.21.05-.4-.03-.56-.08-.16-.72-1.73-.98-2.37-.26-.62-.52-.54-.72-.55h-.61c-.21 0-.56.08-.85.4-.29.32-1.11 1.09-1.11 2.65 0 1.57 1.14 3.08 1.3 3.29.16.21 2.24 3.42 5.43 4.8.76.33 1.35.52 1.81.67.76.24 1.45.2 2 .12.61-.09 1.89-.77 2.15-1.52.27-.74.27-1.38.19-1.52-.08-.13-.29-.21-.61-.37Z"/>
  </svg>
  <span class="whatsapp__label">{label}</span>
</a>
