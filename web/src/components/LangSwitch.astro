---
import { LANGS, lp } from '../lib/i18n';
import type { Lang } from '../lib/i18n';
import { ui } from '../lib/ui';

// La lingua si sceglie anche a mano: la scelta resta in memoria e il
// reindirizzamento automatico (in Base.astro) da quel momento la rispetta.
interface Props { lang: Lang; path: string; class?: string }
const { lang, path, class: className } = Astro.props;
---
<nav class:list={['lang-switch', className]} aria-label={ui[lang].nav.language}>
  <ul>
    {LANGS.map((l) => (
      <li>
        <a href={lp(l, path)} hreflang={l} lang={l} data-lang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>
      </li>
    ))}
  </ul>
</nav>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.lang-switch [data-lang]').forEach((a) => {
    a.addEventListener('click', () => {
      try { localStorage.setItem('boboli-lang', a.dataset.lang!); } catch {}
    });
  });
</script>
