---
import Figure from './Figure.astro';
import { href } from '../lib/site';
import type { CollectionEntry } from 'astro:content';

interface Props { locali: CollectionEntry<'locali'>[] }
const { locali } = Astro.props;
---
<section class="locations" id="firenze">
  <h2 class="locations__title">Tre porte in Via Romana. Una in Via Ghibellina.</h2>
  <div class="locations__grid">
    <Figure
      slot="mappa"
      class="locations__map"
      alt="Mappa dei quattro locali Boboli a Firenze: tre in Via Romana, nell'Oltrarno, e uno in Via Ghibellina, a Santa Croce"
      label="MAPPA — 4 pin con i civici: 45/R · 52 · 60R in Oltrarno, 147/R a Santa Croce"
      widths={[560, 1120]}
      sizes="(max-width: 760px) 100vw, 50vw"
    />
    <ul class="locations__list">
      {locali.map((l) => (
        <li>
          <span class="locations__civic" aria-hidden="true">{l.data.civic}</span>
          <div>
            <a class="locations__name" href={href(`/locali/${l.id}/`)}>{l.data.nameShort}</a>
            <p class="locations__addr">{l.data.street}, {l.data.postalCode} {l.data.city} · {l.data.zone}</p>
            {(l.data.phone || l.data.openingHours.length > 0) && (
              <p class="locations__meta">
                {l.data.phone && <a href={`tel:${l.data.phone.replace(/\s+/g, '')}`}>{l.data.phone}</a>}
                {l.data.openingHours.map((h) => <span>{h}</span>)}
              </p>
            )}
          </div>
          <a class="btn btn--terracotta" href={href(`/locali/${l.id}/`)} data-book={l.data.ctaLabel === 'Prenota' ? l.id : undefined}>{l.data.ctaLabel}</a>
        </li>
      ))}
    </ul>
  </div>
</section>
