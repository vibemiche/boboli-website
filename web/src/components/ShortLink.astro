---
import { lp } from '../lib/i18n';
import type { Lang } from '../lib/i18n';

// Un indirizzo corto e stampabile (biglietti da visita, QR code) che porta
// dritto a una sezione della home. Fuori dall'indice: la pagina vera è la home.
interface Props { lang: Lang; to: string }
const { lang, to } = Astro.props;
const target = lp(lang, to);
const abs = new URL(target, Astro.site).href;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <link rel="canonical" href={abs} />
  <meta http-equiv="refresh" content={`0;url=${target}`} />
  <title>Trattoria Boboli</title>
  <script is:inline define:vars={{ target }}>location.replace(target);</script>
</head>
<body><a href={target}>Trattoria Boboli</a></body>
</html>
