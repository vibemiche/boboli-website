---
import Logo from './Logo.astro';
import Badges from './Badges.astro';
import Figure from './Figure.astro';
import { lp } from '../lib/i18n';
import type { Lang } from '../lib/i18n';
import type { Locale } from '../lib/locali';
import { ui } from '../lib/ui';

// `overHero`: solo la home apre su una foto e l'header parte trasparente
interface Props { lang: Lang; locali: Locale[]; overHero?: boolean }
const { lang, locali, overHero = false } = Astro.props;
const t = ui[lang];
// `preview` è la foto che il menu mostra a destra quando passi sulla voce
const links = [
  ...locali.map((l) => ({ label: l.nameShort, meta: l.street, path: `/locali/${l.id}/`, preview: `locali/${l.id}`, alt: l.imageAlt })),
  { label: t.nav.menu, meta: t.nav.menuMeta, path: '/menu/', preview: null, alt: '' },
  { label: t.nav.lab, meta: t.nav.labMeta, path: '/#laboratorio', preview: 'laboratorio', alt: t.lab.alt },
];
const previews = [{ slot: 'hero', alt: t.hero.alt }, ...links.flatMap((l) => (l.preview ? [{ slot: l.preview, alt: l.alt }] : []))];
const more = [
  { label: t.nav.events, path: '/eventi/' },
  { label: t.nav.smartbox, path: '/smartbox/' },
  { label: t.nav.jobs, path: '/lavora-con-noi/' },
];
// l'indice al centro dell'header: le sezioni della home, da qualunque pagina
const index = [
  { label: t.nav.places, hash: 'locali' },
  { label: t.nav.food, hash: 'menu' },
  { label: t.nav.lab, hash: 'laboratorio' },
  { label: t.nav.reviews, hash: 'recensioni' },
];
---
<header class:list={['site-header', { 'is-solid': !overHero }]} data-over-hero={overHero ? '' : undefined}>
  <a class="brand" href={lp(lang, '/')} aria-label={t.nav.home}><Logo /></a>
  <nav class="site-header__index" aria-label={t.nav.sections}>
    <ul>
      {index.map((i) => <li><a href={lp(lang, `/#${i.hash}`)} data-index={i.hash}>{i.label}</a></li>)}
    </ul>
  </nav>
  <div class="site-header__actions">
    <a class="btn btn--ink" href={lp(lang, '/#locali')} data-book>{t.nav.book}</a>
    <button class="burger" type="button" aria-expanded="false" aria-controls="nav-overlay" aria-label={t.nav.open} data-open={t.nav.open} data-close={t.nav.close}>
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<nav class="nav-overlay" id="nav-overlay" hidden>
  <button class="nav-overlay__close" type="button" aria-label={t.nav.close}>&times;</button>
  <div class="nav-overlay__main">
    <ul class="nav-overlay__list">
      {links.map((l, i) => (
        <li style={`--i:${i}`}><a href={lp(lang, l.path)} data-preview={l.preview ?? 'hero'}>{l.label}<small>{l.meta}</small></a></li>
      ))}
    </ul>
    <ul class="nav-overlay__more">
      {more.map((l) => <li><a href={lp(lang, l.path)}>{l.label}</a></li>)}
    </ul>
    <div class="nav-overlay__foot">
      <a class="btn btn--terracotta" href={lp(lang, '/#locali')} data-book>{t.nav.book}</a>
      <Badges lang={lang} class="nav-overlay__badges" />
    </div>
    <span class="nav-overlay__meta u-label">{t.nav.tagline}</span>
  </div>
  <div class="nav-overlay__preview" aria-hidden="true">
    {previews.map((p, i) => (
      <div class:list={['nav-overlay__shot', { 'is-active': i === 0 }]} data-shot={p.slot}>
        <Figure slot={p.slot} alt="" label="" widths={[960, 1440, 1920]} sizes="(min-width: 901px) 150vh, 1px" />
      </div>
    ))}
  </div>
</nav>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const overlay = document.getElementById('nav-overlay');
  const closeBtn = overlay?.querySelector<HTMLButtonElement>('.nav-overlay__close');

  // Sopra l'hero l'header è trasparente; appena la pagina scorre diventa una
  // barra piena, e nelle pagine senza hero lo è da subito. Scendendo si fa da
  // parte per lasciare spazio, risalendo torna.
  if (header) {
    const always = !header.hasAttribute('data-over-hero');
    let last = window.scrollY;
    const update = () => {
      const y = window.scrollY;
      header.classList.toggle('is-solid', always || y > 24);
      if (y < 140 || y < last - 6) header.classList.remove('is-hidden');
      else if (y > last + 6) header.classList.add('is-hidden');
      if (Math.abs(y - last) > 6) last = y;
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    // un link dell'indice porta sempre la barra con sé
    header.addEventListener('focusin', () => header.classList.remove('is-hidden'));
  }

  // Sulla home la voce dell'indice segue la sezione in cui ti trovi.
  const indexLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-index]')];
  const targets = indexLinks.map((a) => document.getElementById(a.dataset.index!)).filter((el): el is HTMLElement => !!el);
  if (targets.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        indexLinks.forEach((a) => (a.dataset.index === e.target.id ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
      }
    }, { rootMargin: '-45% 0px -50% 0px' });
    targets.forEach((el) => io.observe(el));
  }

  if (burger && overlay) {
    // Col menu aperto il resto del sito è inerte: Tab resta nel menu, lo screen
    // reader legge solo il menu e la pagina sotto non scorre, anche su iOS.
    const rest = [...document.querySelectorAll<HTMLElement>('main, footer, .mobile-bar, .site-header__index, .site-header .brand, .site-header .btn')];
    const setOpen = (open: boolean) => {
      overlay.hidden = !open;
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? burger.dataset.close! : burger.dataset.open!);
      document.documentElement.classList.toggle('is-locked', open);
      rest.forEach((el) => (el.inert = open));
      if (open) overlay.querySelector('a')?.focus();
      else burger.focus();
    };

    burger.addEventListener('click', () => setOpen(overlay.hidden));
    closeBtn?.addEventListener('click', () => setOpen(false));
    overlay.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !overlay.hidden) setOpen(false);
    });

    // passando su una voce, a destra compare la foto del posto
    const shots = [...overlay.querySelectorAll<HTMLElement>('[data-shot]')];
    const show = (slot: string) => shots.forEach((s) => s.classList.toggle('is-active', s.dataset.shot === slot));
    overlay.querySelectorAll<HTMLAnchorElement>('[data-preview]').forEach((a) => {
      a.addEventListener('pointerenter', () => show(a.dataset.preview!));
      a.addEventListener('focus', () => show(a.dataset.preview!));
    });
  }
</script>
