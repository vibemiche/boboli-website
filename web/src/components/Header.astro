---
import { getCollection } from 'astro:content';
import { href } from '../lib/site';
import Logo from './Logo.astro';

const locali = (await getCollection('locali')).sort((a, b) => a.data.listOrder - b.data.listOrder);
const links = [
  ...locali.map((l) => ({ label: l.data.nameShort, meta: l.data.street, path: `/locali/${l.id}/` })),
  { label: 'Menu', meta: 'Tutto senza glutine', path: '/#menu' },
  { label: 'Il laboratorio', meta: 'Fatto da noi', path: '/#laboratorio' },
];
---
<header class="site-header">
  <a class="brand" href={href('/')}><Logo /></a>
  <div class="site-header__actions">
    <span class="lang u-label">IT / EN</span>
    <a class="btn btn--ink" href={href('/#firenze')} data-book>Prenota</a>
    <button class="burger" type="button" aria-expanded="false" aria-controls="nav-overlay" aria-label="Apri il menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<nav class="nav-overlay" id="nav-overlay" hidden>
  <button class="nav-overlay__close" type="button" aria-label="Chiudi il menu">&times;</button>
  <ul class="nav-overlay__list">
    {links.map((l) => <li><a href={href(l.path)}>{l.label}<small>{l.meta}</small></a></li>)}
  </ul>
  <span class="nav-overlay__meta u-label">100% gluten free · dal 1978 · Firenze</span>
</nav>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const overlay = document.getElementById('nav-overlay');
  const closeBtn = overlay?.querySelector<HTMLButtonElement>('.nav-overlay__close');

  if (burger && overlay) {
    const setOpen = (open: boolean) => {
      overlay.hidden = !open;
      burger.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) overlay.querySelector('a')?.focus();
      else burger.focus();
    };

    burger.addEventListener('click', () => setOpen(overlay.hidden));
    closeBtn?.addEventListener('click', () => setOpen(false));
    overlay.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !overlay.hidden) setOpen(false);
    });
  }
</script>
