---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import WhatsApp from '../components/WhatsApp.astro';
import BookingDialog from '../components/BookingDialog.astro';
import Consent from '../components/Consent.astro';
import Tracking from '../components/Tracking.astro';
import { indexable, href } from '../lib/site';
import { GTM_ID, tracking } from '../lib/tracking';
import { LANGS, FALLBACK, OG_LOCALE, lp } from '../lib/i18n';
import type { Lang } from '../lib/i18n';
import { getLocali } from '../lib/locali';
import { ui } from '../lib/ui';

interface Props {
  lang: Lang;
  /** Il percorso senza prefisso di lingua, uguale in tutte le lingue: `/`, `/locali/to-go/`. */
  path: string;
  title: string;
  description: string;
  image: string | null;
  jsonLd?: unknown[];
  /** La pagina apre su una foto a tutto schermo (la home): l'header parte trasparente. */
  overHero?: boolean;
  /** Le lingue in cui esiste la pagina: il blog è solo in italiano. */
  langs?: readonly Lang[];
  /** Pagine di servizio (il grazie dopo la prenotazione): fuori da Google. */
  noindex?: boolean;
}

const { lang, path, title, description, image, jsonLd = [], overHero = false, langs = LANGS, noindex = false } = Astro.props;
const t = ui[lang];
const locali = await getLocali(lang);
const abs = (l: Lang) => new URL(lp(l, path), Astro.site).href;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#ffffff" />
  <meta name="color-scheme" content="light" />
  <meta name="format-detection" content="telephone=no" />
  <link rel="icon" href={href('/favicon.ico')} sizes="32x32" />
  <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
  <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={abs(lang)} />
  {(!indexable || noindex) && <meta name="robots" content="noindex, nofollow" />}

  {langs.map((l) => <link rel="alternate" hreflang={l} href={abs(l)} />)}
  <link rel="alternate" hreflang="x-default" href={abs(langs.includes(FALLBACK) ? FALLBACK : langs[0])} />

  {/* Nessun selettore: comanda la lingua del browser. I crawler restano dove
      arrivano, altrimenti Google (che naviga in inglese) non vedrebbe mai
      l'italiano. Lo script legge gli hreflang qui sopra, quindi deve seguirli. */}
  <script is:inline define:vars={{ langs: LANGS, fallback: FALLBACK }}>
    (function () {
      try {
        if (/bot|crawl|spider|slurp|lighthouse|pagespeed|preview|facebookexternalhit|whatsapp|headless/i.test(navigator.userAgent)) return;
        var want = fallback;
        // la lingua scelta a mano dal selettore vince su quella del browser
        var saved = null;
        try { saved = localStorage.getItem('boboli-lang'); } catch (e) {}
        if (saved && langs.indexOf(saved) > -1) want = saved;
        else {
          var prefs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
          for (var i = 0; i < prefs.length; i++) {
            var code = String(prefs[i]).slice(0, 2).toLowerCase();
            if (langs.indexOf(code) > -1) { want = code; break; }
          }
        }
        if (want === document.documentElement.lang) return;
        var alt = document.querySelector('link[rel="alternate"][hreflang="' + want + '"]');
        if (alt) location.replace(alt.href + location.hash);
      } catch (e) {}
    })();
  </script>

  {/* Consent Mode v2: tutto negato finché il visitatore non accetta dal banner;
      la scelta salvata vale dalle visite successive. Poi Tag Manager. */}
  {tracking && (
    <script is:inline define:vars={{ gtm: GTM_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      var ALL = ['ad_storage', 'ad_user_data', 'ad_personalization', 'analytics_storage'];
      function state(v) { var o = {}; ALL.forEach(function (k) { o[k] = v; }); return o; }
      var d = state('denied'); d.wait_for_update = 500;
      gtag('consent', 'default', d);
      window.boboliConsent = function (v) { gtag('consent', 'update', state(v)); dataLayer.push({ event: 'consent_choice', consent: v }); };
      try { if (localStorage.getItem('boboli-consent') === 'granted') gtag('consent', 'update', state('granted')); } catch (e) {}
      (function (w, d, s, l, i) { w[l] = w[l] || []; w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0], j = d.createElement(s); j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i; f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', gtm);
    </script>
  )}

  <meta property="og:type" content="website" />
  <meta property="og:locale" content={OG_LOCALE[lang]} />
  {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
  <meta property="og:site_name" content="Trattoria Boboli" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={abs(lang)} />
  {image && <meta property="og:image" content={image} />}
  <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />

  {jsonLd.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
</head>
<body>
  {tracking && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>}
  <a class="skip-link" href="#contenuto">{t.meta.skip}</a>
  <Header lang={lang} locali={locali} overHero={overHero} path={path} langs={langs} />
  <main id="contenuto">
    <slot />
  </main>
  <Footer lang={lang} locali={locali} path={path} langs={langs} />
  <BookingDialog lang={lang} locali={locali} />
  <MobileBar lang={lang} />
  <WhatsApp lang={lang} />
  {tracking && <Consent lang={lang} />}
  <Tracking />
</body>
</html>
