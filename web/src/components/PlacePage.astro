---
import Base from '../layouts/Base.astro';
import Figure from './Figure.astro';
import FormatBlock from './FormatBlock.astro';
import Badges from './Badges.astro';
import Reveal from './Reveal.astro';
import { lp } from '../lib/i18n';
import type { Lang } from '../lib/i18n';
import { getLocali, toneOf } from '../lib/locali';
import { ui } from '../lib/ui';
import { telHref, formatHours, directionsUrl } from '../lib/contact';
import { findSeries } from '../lib/images';
import { restaurantSchema, breadcrumbSchema, socialImage } from '../lib/schema';

interface Props { lang: Lang; id: string }
const { lang, id } = Astro.props;
const t = ui[lang];
const site = Astro.site!;

const locali = await getLocali(lang);
const l = locali.find((x) => x.id === id)!;
const others = locali.filter((x) => x.id !== id);
const tone = toneOf(l.id);
const maps = directionsUrl(l);
const path = `/locali/${l.id}/`;
const image = await socialImage(`locali/${l.id}`, site);
// Le foto in più del locale: `locali/<id>-2-….jpg`, `locali/<id>-3-….jpg`, accanto alle informazioni.
const gallery = findSeries(`locali/${l.id}`)
  .filter(({ name }) => name !== l.id)
  .map(({ name }, i) => ({ slot: `locali/${name}`, alt: l.galleryAlt[i] ?? l.imageAlt }));

const jsonLd = [
  restaurantSchema(l, lang, t, site, image),
  breadcrumbSchema([{ name: 'Trattoria Boboli', url: lp(lang, '/') }, { name: l.nameShort, url: lp(lang, path) }], site),
];
---
<Base
  lang={lang}
  path={path}
  title={t.meta.placeTitle(l.nameShort, l.street)}
  description={t.meta.placeDesc(l.nameLegal, l.blurb, l.street, l.zone)}
  image={image}
  jsonLd={jsonLd}
>
  <article class="place">
    <FormatBlock lang={lang} locale={l} {...tone} level="h1" kicker={l.nameLegal} more={false} priority>
      <nav slot="crumb" class="u-label place__crumb" aria-label={t.place.crumb}>
        <a href={lp(lang, '/')}>Boboli</a> <span aria-hidden="true">›</span> <span aria-current="page">{l.nameShort}</span>
      </nav>
      <Fragment slot="actions">
        {l.bookable && l.phone && <a class="btn btn--ghost" href={telHref(l.phone)}>{t.book.call}</a>}
        <a class="btn btn--ghost" href={maps} target="_blank" rel="noopener">{t.place.directions}</a>
      </Fragment>
    </FormatBlock>

    <section class:list={['place__info', { 'place__info--photo': gallery.length > 0 }]}>
      <div class="place__info-text" data-reveal>
        <dl class="place__facts">
          <div><dt class="u-label">{t.place.address}</dt><dd><a href={maps} target="_blank" rel="noopener">{l.street}, {l.postalCode} {l.city}</a><br />{l.zone}</dd></div>
          {l.phone && <div><dt class="u-label">{t.place.phone}</dt><dd><a href={telHref(l.phone)}>{l.phone}</a></dd></div>}
          {l.hours.length > 0 && <div><dt class="u-label">{t.place.hours}</dt><dd>{formatHours(l.hours, t.hours).map((h) => <span>{h}<br /></span>)}</dd></div>}
          <div><dt class="u-label">{t.place.cuisine}</dt><dd>{t.place.cuisineValue}</dd></div>
        </dl>
        <div class="place__promise">
          <Badges lang={lang} class="place__badges" />
          <p>{t.place.text}</p>
        </div>
      </div>
      {gallery.map((g) => (
        <div class="place__photo" data-reveal>
          <Figure slot={g.slot} alt={g.alt} label="" widths={[480, 800, 1200, 1600]} sizes="(max-width: 760px) 100vw, 42vw" />
        </div>
      ))}
    </section>

    <nav class="place__others" aria-label={t.place.others}>
      <h2 class="place__others-title">{t.place.others}</h2>
      <ul class="others" data-reveal>
        {others.map((o) => (
          <li>
            <a class="others__card" href={lp(lang, `/locali/${o.id}/`)}>
              <Figure class="others__photo" slot={`locali/${o.id}`} alt="" label="" widths={[480, 800, 1200, 1600]} sizes="(max-width: 760px) max(100vw, 500px), 40vw" transition={`locale-${o.id}`} />
              <span class="u-label others__kicker">{o.street}</span>
              <span class="others__verb">{o.choiceVerb} <span class="others__arrow" aria-hidden="true">&rarr;</span></span>
              <span class="others__sub">{o.choiceSub}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </article>
  <Reveal />
</Base>
