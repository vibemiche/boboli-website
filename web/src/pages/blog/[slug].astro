---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import { lp } from '../../lib/i18n';
import { ui } from '../../lib/ui';
import { getPosts, dateIt, isoDay, minutesOf, wordsOf, type Post } from '../../lib/blog';
import { blogPostingSchema, breadcrumbSchema, faqSchema, socialImage } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, others: posts.filter((p) => p.id !== post.id) } }));
}

interface Props { post: Post; others: Post[] }
const { post, others } = Astro.props;
const d = post.data;
const t = ui.it;
const site = Astro.site!;
const path = `/blog/${post.id}/`;
const { Content, headings } = await render(post);
// l'indice: solo i capitoli (h2)
const toc = [
  ...headings.filter((h) => h.depth === 2),
  ...(d.faq.length ? [{ slug: 'domande', text: 'Domande frequenti' }] : []),
];
const image = await socialImage(d.image, site);
const jsonLd = [
  blogPostingSchema({ ...d, wordCount: wordsOf(post) }, lp('it', path), image, site),
  breadcrumbSchema(
    [{ name: 'Trattoria Boboli', url: lp('it', '/') }, { name: 'Blog', url: lp('it', '/blog/') }, { name: d.title, url: lp('it', path) }],
    site,
  ),
  ...(d.faq.length ? [faqSchema(d.faq.map((f) => [f.q, f.a] as [string, string]))] : []),
];
---
<Base lang="it" path={path} langs={['it']} title={d.seoTitle} description={d.description} image={image} jsonLd={jsonLd}>
  <article class="post">
    <header class="post__head">
      <nav class="u-label place__crumb" aria-label={t.place.crumb}>
        <a href={lp('it', '/')}>Boboli</a> <span aria-hidden="true">›</span> <a href={lp('it', '/blog/')}>Blog</a>
      </nav>
      <p class="u-label post__kicker">{d.kicker}</p>
      <h1 class="post__title">{d.title}</h1>
      <p class="post__lead">{d.lead}</p>
      <p class="post__meta">
        <span>Trattoria Boboli</span>
        <span aria-hidden="true">·</span>
        {d.updated && d.updated > d.date
          ? <span>Aggiornato il <time datetime={isoDay(d.updated)}>{dateIt(d.updated)}</time></span>
          : <time datetime={isoDay(d.date)}>{dateIt(d.date)}</time>}
        <span aria-hidden="true">·</span>
        <span>{minutesOf(post)} min di lettura</span>
      </p>
    </header>
    <div class="post__media">
      <Figure slot={d.image} alt={d.imageAlt} label="" widths={[640, 960, 1280, 1600]} sizes="(max-width: 760px) 100vw, min(1040px, 92vw)" priority />
    </div>

    <div class="post__grid">
      {toc.length > 2 && (
        <nav class="post__toc" aria-labelledby="indice">
          <p class="u-label" id="indice">In questo articolo</p>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <div class="prose">
        <Content />

        {d.faq.length > 0 && (
          <section class="post__faq" aria-labelledby="domande">
            <h2 id="domande">Domande frequenti</h2>
            {d.faq.map((f) => (
              <details>
                <summary>{f.q}<span aria-hidden="true">+</span></summary>
                <p>{f.a}</p>
              </details>
            ))}
          </section>
        )}

        <aside class="post__cta">
          <p class="post__cta-title">A tavola!</p>
          <p>Quattro locali a Firenze, tutta la cucina 100% senza glutine.</p>
          <div class="post__cta-actions">
            <a class="btn btn--terracotta" href={lp('it', '/#locali')} data-book>{t.nav.book}</a>
            <a class="btn btn--ghost" href={lp('it', '/menu/')}>{t.nav.food}</a>
          </div>
        </aside>
      </div>
    </div>
  </article>

  {others.length > 0 && (
    <nav class="post__more" aria-labelledby="altri">
      <h2 class="u-label" id="altri">Continua a leggere</h2>
      <ul class="blog__list">
        {others.map((p) => (
          <li class="card">
            <a class="card__link" href={lp('it', `/blog/${p.id}/`)}>
              <div class="card__media">
                <Figure slot={p.data.image} alt={p.data.imageAlt} label="" widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 33vw" />
              </div>
              <p class="u-label card__kicker">{p.data.kicker}</p>
              <h3 class="card__title">{p.data.title}</h3>
              <p class="card__meta"><time datetime={isoDay(p.data.date)}>{dateIt(p.data.date)}</time> · {minutesOf(p)} min di lettura</p>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}
</Base>
