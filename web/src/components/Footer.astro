---
import Logo from './Logo.astro';
import Badges from './Badges.astro';
import LangSwitch from './LangSwitch.astro';
import { lp } from '../lib/i18n';
import type { Lang } from '../lib/i18n';
import type { Locale } from '../lib/locali';
import { ui } from '../lib/ui';

interface Props { lang: Lang; locali: Locale[]; path: string; langs?: readonly Lang[] }
const { lang, locali, path, langs } = Astro.props;
const t = ui[lang];

const columns = [
  {
    title: t.footer.discover,
    links: [
      { label: t.footer.links.lab, path: '/#laboratorio' },
      { label: t.footer.links.manifesto, path: '/#manifesto' },
      { label: t.footer.links.menu, path: '/menu/' },
      // il blog esiste solo in italiano
      ...(lang === 'it' ? [{ label: 'Blog', path: '/blog/' }] : []),
    ],
  },
  {
    title: t.footer.contact,
    links: [
      { label: t.nav.book, path: '/#locali', book: true },
      { label: t.footer.faq, path: '/#faq' },
      { label: t.footer.links.events, path: '/eventi/' },
      { label: t.footer.links.smartbox, path: '/smartbox/' },
      { label: t.footer.links.jobs, path: '/lavora-con-noi/' },
    ],
  },
];
---
<footer class="site-footer">
  <div class="site-footer__brand">
    <Logo class="site-footer__logo" />
    <p class="site-footer__tagline">{t.footer.tagline[0]}<br />{t.footer.tagline[1]}</p>
    <Badges lang={lang} class="site-footer__badges" />
    <LangSwitch lang={lang} path={path} langs={langs} class="site-footer__lang" />
  </div>
  <nav class="site-footer__col site-footer__locali" aria-label={t.footer.locali}>
    <p class="u-label">{t.footer.locali}</p>
    {locali.map((l) => (
      <a href={lp(lang, `/locali/${l.id}/`)}>
        {l.nameLegal}
        <span class="site-footer__addr">{l.street}, {l.postalCode} {l.city}{l.phone && ` · ${l.phone}`}</span>
      </a>
    ))}
  </nav>
  {columns.map((col) => (
    <nav class="site-footer__col" aria-label={col.title}>
      <p class="u-label">{col.title}</p>
      {col.links.map((l) => <a href={lp(lang, l.path)} data-book={'book' in l ? '' : undefined}>{l.label}</a>)}
    </nav>
  ))}
</footer>
