---
import type { Lang } from '../lib/i18n';
import { ui } from '../lib/ui';
import { seoLink } from '../lib/faq';

interface Props { lang: Lang; faq: [string, string][] }
const { lang, faq } = Astro.props;
const t = ui[lang].seo;
---
<section class="seo">
  <h2 class="seo__title">{t.title}</h2>
  <div class="seo__grid">
    <div class="seo__copy">
      {t.copy(seoLink(lang)).map((p) => <p set:html={p} />)}
    </div>
    <div class="faq" id="faq">
      <h3 class="u-label faq__title">{t.faqTitle}</h3>
      {faq.map(([q, a]) => (
        <details>
          <summary><span>{q}</span><span class="faq__sign" aria-hidden="true">+</span></summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
