---
import GuidePage from '../../components/GuidePage.astro';
import { GUIDES } from '../../lib/guides';
import { TRANSLATED } from '../../lib/i18n';
import type { Lang } from '../../lib/i18n';

export function getStaticPaths() {
  return TRANSLATED.flatMap((lang) => GUIDES.map((guide) => ({ params: { lang, guide: guide.path.replace(/^\/|\/$/g, '') }, props: { guide } })));
}
const { guide } = Astro.props;
---
<GuidePage lang={Astro.params.lang as Lang} guide={guide} />
