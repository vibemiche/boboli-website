---
import Figure from './Figure.astro';
import { href } from '../lib/site';
import { telHref } from '../lib/contact';
import type { CollectionEntry } from 'astro:content';

interface Props { locale: CollectionEntry<'locali'>; anchor: string; dark?: boolean; bleed?: boolean }
const { locale, anchor, dark = false, bleed = false } = Astro.props;
const d = locale.data;
const page = href(`/locali/${locale.id}/`);
const books = d.ctaLabel === 'Prenota';
const primaryHref = books ? href('/#firenze') : d.phone ? telHref(d.phone) : page;
---
<section class:list={['format', { 'format--dark': dark, 'format--bleed': bleed }]} id={anchor}>
  <div class="format__media">
    <Figure slot={`locali/${locale.id}`} alt={d.imageAlt} label={`IMG FULL-BLEED — ${d.imageAlt}`} widths={[768, 1280, 1920, 2560]} />
    <span class="format__num" aria-hidden="true">{d.civic}</span>
  </div>
  <div class="format__body">
    <div class="format__text">
      <p class="u-label format__kicker">{d.kicker}</p>
      <h2 class="format__title">{d.title}</h2>
      {d.insight && <p class="format__insight">{d.insight}</p>}
      <p class="format__blurb">{d.blurb}</p>
      <p class="u-label format__address">{d.street} · {d.zone}</p>
    </div>
    <div class="format__actions">
      <a class="link-more" href={page}>Il locale &rarr;</a>
      <a class:list={['btn', dark ? 'btn--cream' : 'btn--ink']} href={primaryHref} data-book={books ? locale.id : undefined}>{d.ctaLabel}</a>
    </div>
  </div>
</section>
