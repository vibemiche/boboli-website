---
import Base from '../layouts/Base.astro';
import Figure from './Figure.astro';
import SiteForm from './SiteForm.astro';
import Field from './Field.astro';
import { lp } from '../lib/i18n';
import type { Lang } from '../lib/i18n';
import { ui } from '../lib/ui';
import { JOBS_EMAIL } from '../lib/forms';
import { breadcrumbSchema, socialImage } from '../lib/schema';

// Solo candidature spontanee: un modulo con il CV allegato, che arriva per mail.
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const j = t.jobs;
const sp = j.spont;
const f = t.form;
const site = Astro.site!;
const image = await socialImage('illustrazioni/staff', site);
const jsonLd = [breadcrumbSchema([{ name: 'Trattoria Boboli', url: lp(lang, '/') }, { name: j.kicker, url: lp(lang, '/lavora-con-noi/') }], site)];
---
<Base lang={lang} path="/lavora-con-noi/" title={j.title} description={j.desc} image={image} jsonLd={jsonLd}>
  <article class="join join--jobs">
    <nav class="u-label place__crumb" aria-label={t.place.crumb}>
      <a href={lp(lang, '/')}>Boboli</a> › <span aria-current="page">{j.kicker}</span>
    </nav>
    <header class="join__head">
      <div>
        <p class="u-label join__kicker">{j.kicker}</p>
        <h1 class="join__title">{j.h1}</h1>
        <p class="join__lead">{j.lead}</p>
      </div>
      <Figure class="join__seal" slot="illustrazioni/staff" alt="" label="" widths={[320, 640]} sizes="(max-width: 760px) 60vw, 30vw" />
    </header>
  </article>

  <section class="apply" id="candidatura" aria-labelledby="candidatura-titolo">
    <div class="apply__intro">
      <p class="u-label apply__kicker">{sp.kicker}</p>
      <h2 class="apply__title" id="candidatura-titolo">{sp.title}</h2>
      <p class="apply__lead">{sp.lead}</p>
    </div>
    <SiteForm
      id="modulo-candidatura"
      class="fs--card"
      lang={lang}
      to={JOBS_EMAIL}
      path="/lavora-con-noi/"
      subject="NUOVA CANDIDATURA - {Nome} {Cognome} - {Telefono} - {Email}"
      submit={sp.submit}
      success={sp.success}
      files
    >
      <Field label={f.name} name="Nome" required autocomplete="given-name" />
      <Field label={f.surname} name="Cognome" required autocomplete="family-name" />
      <Field label={f.email} name="Email" type="email" required autocomplete="email" />
      <Field label={f.phone} name="Telefono" type="tel" required autocomplete="tel" placeholder="+39" />
      <Field label={sp.area} name="Area" type="select" options={sp.areas} choose={f.choose} required wide />
      <Field label={sp.message} name="Presentazione" type="textarea" hint={sp.messageHint} required />
      <Field label={sp.cv} name="attachment" type="file" hint={sp.cvHint} accept=".pdf,.doc,.docx,application/pdf" required maxMb={5} tooBig={sp.cvTooBig} />
    </SiteForm>
  </section>
</Base>
