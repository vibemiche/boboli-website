---
import { getCollection } from 'astro:content';
import { href } from '../lib/site';
import Logo from './Logo.astro';

const locali = (await getCollection('locali')).sort((a, b) => a.data.listOrder - b.data.listOrder);

const columns = [
  {
    title: 'Scopri',
    links: [
      { label: 'Il laboratorio', path: '/#laboratorio' },
      { label: '100% gluten free', path: '/#manifesto' },
      { label: 'Il menu', path: '/#menu' },
      { label: 'I prodotti', path: '/#prodotti' },
    ],
  },
  {
    title: 'Contatti',
    links: [
      { label: 'Prenota', path: '/#firenze', book: true },
      { label: 'Domande frequenti', path: '/#faq' },
    ],
  },
];
---
<footer class="site-footer">
  <div class="site-footer__brand">
    <Logo class="site-footer__logo" />
    <p class="site-footer__tagline">La libertà di scegliere.<br />100% gluten free · Firenze, dal 1978</p>
    <p class="u-label site-footer__lang">IT / EN</p>
  </div>
  <nav class="site-footer__col site-footer__locali" aria-label="I locali">
    <p class="u-label">I locali</p>
    {locali.map((l) => (
      <a href={href(`/locali/${l.id}/`)}>
        {l.data.nameLegal}
        <span class="site-footer__addr">{l.data.street}, {l.data.postalCode} {l.data.city}{l.data.phone && ` · ${l.data.phone}`}</span>
      </a>
    ))}
  </nav>
  {columns.map((col) => (
    <nav class="site-footer__col">
      <p class="u-label">{col.title}</p>
      {col.links.map((l) => <a href={href(l.path)} data-book={l.book ? '' : undefined}>{l.label}</a>)}
    </nav>
  ))}
</footer>
