---
import Placeholder from './Placeholder.astro';
import { href } from '../lib/site';
---
<section class="hero" id="top">
  <Placeholder class="hero__media" label="IMG FULL-SCREEN — 100vh · tavola imbandita, tutto senza glutine" />
  <p class="hero__side u-label">100% gluten free · dal 1978 · Firenze</p>
  <div class="hero__bottom">
    <h1 class="hero__word">SCEGLI</h1>
    <div class="hero__row">
      <p class="hero__claim">
        Una cucina 100% senza glutine a Firenze. Scegli cosa mangiare. Scegli dove.<span class="d-only"> Scegli come vivere Boboli.</span>
      </p>
      <a class="hero__scroll" href={href('/#intro')}>
        <span class="u-label d-only">Scroll</span>
        <span class="u-label m-only">100% gluten free</span>
        <span class="hero__arrow" aria-hidden="true">&darr;</span>
      </a>
    </div>
  </div>
</section>
