---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ChoiceIndex from '../components/ChoiceIndex.astro';
import FormatBlock from '../components/FormatBlock.astro';
import Manifesto from '../components/Manifesto.astro';
import Laboratorio from '../components/Laboratorio.astro';
import MenuSection from '../components/MenuSection.astro';
import Locations from '../components/Locations.astro';
import SeoFaq, { faq } from '../components/SeoFaq.astro';
import { restaurantSchema, organizationSchema, faqSchema } from '../lib/schema';

const locali = await getCollection('locali');
const formats = locali
  .filter((l) => l.data.formatOrder !== null)
  .sort((a, b) => a.data.formatOrder! - b.data.formatOrder!);
const inList = [...locali].sort((a, b) => a.data.listOrder - b.data.listOrder);

const anchors: Record<string, string> = {
  'trattoria-1978': 'trattoria',
  'al-bargello': 'bargello',
  'to-go': 'togo',
};

const jsonLd = [
  organizationSchema(Astro.site!),
  ...locali.map((l) => restaurantSchema(l, Astro.site!)),
  faqSchema(faq),
];
---
<Base
  title="Boboli — Scegli · 100% gluten free a Firenze, dal 1978"
  description="Boboli a Firenze: quattro locali e un laboratorio, tutta la cucina senza glutine. Trattoria, Bargello, To-Go e Cantina in Via Romana e Via Ghibellina. Tutto il menu, tutta la scelta."
  jsonLd={jsonLd}
>
  <Hero />
  <ChoiceIndex locali={inList} />
  {formats.map((l, i) => (
    <FormatBlock locale={l} anchor={anchors[l.id]} dark={i === 1} bleed={i === 2} />
  ))}
  <Manifesto />
  <Laboratorio />
  <MenuSection />
  <Locations locali={inList} />
  <SeoFaq />
</Base>
