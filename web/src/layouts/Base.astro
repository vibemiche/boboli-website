---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import BookingDialog from '../components/BookingDialog.astro';
import { indexable } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Percorso della versione inglese, quando esiste: senza, niente hreflang. */
  enPath?: string;
  jsonLd?: unknown[];
  ogImagePath?: string;
}

const { title, description, enPath, jsonLd = [], ogImagePath } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// L'immagine di anteprima social esiste solo quando l'archivio fotografico
// arriva: meglio nessun og:image che un og:image che punta nel vuoto.
const ogImage = ogImagePath ? new URL(import.meta.env.BASE_URL + ogImagePath, Astro.site).href : null;
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {!indexable && <meta name="robots" content="noindex, nofollow" />}

  {enPath && (
    <>
      <link rel="alternate" hreflang="it" href={canonical} />
      <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site).href} />
      <link rel="alternate" hreflang="x-default" href={canonical} />
    </>
  )}

  <meta property="og:type" content="website" />
  <meta property="og:locale" content="it_IT" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

  {jsonLd.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
</head>
<body>
  <a class="skip-link" href="#contenuto">Vai al contenuto</a>
  <Header />
  <main id="contenuto">
    <slot />
  </main>
  <Footer />
  <BookingDialog />
  <MobileBar />
</body>
</html>
